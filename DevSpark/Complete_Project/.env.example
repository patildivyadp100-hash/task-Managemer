# =============================================================================
# TaskFlow Environment Variables Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# =============================================================================

# Flask Secret Key (generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=dev-secret-key-change-in-production

# Enable Debug Mode (True for local development, False for production)
FLASK_DEBUG=False

# SQLite Database File Name
DATABASE=tasks.db
